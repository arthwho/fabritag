# PostgreSQL local
DB_NAME=fabritag
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_CONNECT_TIMEOUT=5
POSTGRES_HOST_PORT=5432

# Portas publicadas pelo Docker Compose
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Endereços públicos da aplicação
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Administrador inicial (somente desenvolvimento local)
ADMIN_EMAIL=admin@fabritag.com
ADMIN_PASSWORD=troque-esta-senha

# Login Google opcional
GOOGLE_CLIENT_ID=
PUBLIC_GOOGLE_CLIENT_ID=
